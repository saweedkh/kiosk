# Optional local overrides for PosBridge ONLY.
# On a delivery kiosk you normally edit the ROOT .env next to run.bat instead.
# This file is optional — config.py already reads the parent .env.

# Listen address (bridge process). Root .env has no BRIDGE_HOST; default is fine.
BRIDGE_HOST=0.0.0.0

# Same meaning as POS_BRIDGE_PORT in root .env
BRIDGE_PORT=9000

# Path to official PNA DLL. Leave empty to auto-detect:
#   1) pos_bridge\pna.pcpos.dll  (delivery ZIP puts it here)
#   2) ..\kiosk_backend\pna.pcpos.dll  (dev repo layout)
POS_DLL_PATH=

# Aliases for root .env keys (only needed if you run bridge without parent .env):
# POS_IP              ↔ POS_TCP_HOST
# POS_PORT            ↔ POS_TCP_PORT
# BRIDGE_TOKEN        ↔ POS_BRIDGE_TOKEN
# POS_TIMEOUT_SECONDS ↔ POS_BRIDGE_TIMEOUT
POS_IP=192.168.1.100
POS_PORT=1362
POS_TIMEOUT_SECONDS=120
BRIDGE_TOKEN=
