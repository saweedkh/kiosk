# =============================================================================
# Kiosk – environment configuration (COMPLETE)
# -----------------------------------------------------------------------------
# Copy to `.env` if needed:  copy .env.example .env
# On a delivery machine this file is already named `.env` — EDIT IT BEFORE RUN.
#
# REQUIRED before production:
#   1) SECRET_KEY          → unique random string
#   2) POSTGRES_PASSWORD   → strong password
# Optional per site:
#   POS / printer / Bale token / store name
# =============================================================================

# --- Django ------------------------------------------------------------------
# Cryptographic signing key. MUST be unique on every production install.
# Generate example (PowerShell):
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 50 | %% {[char]$_})
SECRET_KEY=change-me-generate-a-unique-secret-key

# True = development only. Production Docker compose also forces DEBUG=False.
DEBUG=False

# Hosts allowed to serve the app (comma-separated). Compose may override with *.
ALLOWED_HOSTS=localhost,127.0.0.1,kiosk.local

# Reference port when running backend outside Docker.
SERVER_PORT=8000

# --- PostgreSQL --------------------------------------------------------------
# Credentials for container `kiosk_db` and Django.
# Change POSTGRES_PASSWORD on every real install.
POSTGRES_DB=kiosk
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=change-me-strong-password

# Hostname of the DB service inside Docker Compose bridge network.
# Do not change for normal production (compose also sets POSTGRES_HOST=db).
# For docker-compose.production.host-network.yml use 127.0.0.1 (compose overrides).
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Persistent Django DB connections (seconds). 0 = close after each request.
POSTGRES_CONN_MAX_AGE=60

# --- Store / Frontend --------------------------------------------------------
# Display name used on receipts / UI where applicable.
STORE_NAME=فروشگاه

# Only used by local `npm run dev`. In Docker production, API base is `/api`.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# --- Payment gateway ---------------------------------------------------------
# mock = no hardware (testing)
# pos  = real TCP card reader
PAYMENT_GATEWAY_NAME=mock

# Required by some POS providers when PAYMENT_GATEWAY_NAME=pos
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_TERMINAL_ID=

# --- Mock gateway (PAYMENT_GATEWAY_NAME=mock) --------------------------------
MOCK_PAYMENT_DELAY=3
MOCK_PAYMENT_SUCCESS=True

# --- POS card reader (PAYMENT_GATEWAY_NAME=pos) ------------------------------
POS_TCP_HOST=192.168.1.100
POS_TCP_PORT=1362
POS_TIMEOUT=30

# Vendor DLL instead of raw TCP (usually False)
POS_USE_DLL=False

# Optional Windows bridge service
POS_USE_BRIDGE=False
POS_BRIDGE_HOST=192.168.1.101
POS_BRIDGE_PORT=9000

# Wire format. Recommended for PNA: pardakht_novin_official
# Options:
#   dll_exact | pardakht_novin_official | with_rq_and_banner |
#   with_length | with_stx_etx | with_terminator | with_null
POS_MESSAGE_FORMAT=pardakht_novin_official

# Simplified PNA-compatible payload (recommended True)
POS_USE_SIMPLE_FORMAT=True

# Used only with with_rq_and_banner format
POS_BANNER=R2023tejaratEParsian

# --- Network receipt printer -------------------------------------------------
PRINTER_ENABLED=False
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# --- Bale Bot ----------------------------------------------------------------
# From @BotFather in Bale. Empty = bot has no token (worker may still start).
BALE_BOT_TOKEN=

# Usually leave as default
BALE_API_BASE=https://tapi.bale.ai

# Long-poll timeout (seconds) for getUpdates
BALE_POLL_TIMEOUT=30

# Set False if you do not want the bot worker used (container may still be in compose)
BALE_BOT_ENABLED=True
