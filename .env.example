# =============================================================================
# Kiosk .env — copy to ".env" next to run.bat and edit before production
# REQUIRED: SECRET_KEY, POSTGRES_PASSWORD
# =============================================================================

# --- Django ------------------------------------------------------------------
SECRET_KEY=change-me-generate-a-unique-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,kiosk.local
SERVER_PORT=8000
# 0 = never seed demo catalog (kiosk). 1 = seed only if products empty
SEED_DEMO_DATA=0

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=kiosk
POSTGRES_USER=kiosk
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
INTERNAL_API_BASE_URL=http://127.0.0.1:8000/api

# --- Payment: mock | pos | bridge --------------------------------------------
PAYMENT_GATEWAY_NAME=bridge
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_TERMINAL_ID=
MOCK_PAYMENT_DELAY=3
MOCK_PAYMENT_SUCCESS=True

# --- POS (device IP) ---------------------------------------------------------
POS_TCP_HOST=192.168.1.102
POS_TCP_PORT=1362
POS_TIMEOUT=30
POS_USE_DLL=False

# --- PosBridge (Windows DLL; run.bat starts pos_bridge\) ----------------------
POS_USE_BRIDGE=True
POS_BRIDGE_HOST=host.docker.internal
POS_BRIDGE_PORT=9000
POS_BRIDGE_TOKEN=
POS_BRIDGE_TIMEOUT=130
POS_MESSAGE_FORMAT=pardakht_novin_official
POS_USE_SIMPLE_FORMAT=True
POS_BANNER=R2023tejaratEParsian

# --- Printer -----------------------------------------------------------------
PRINTER_ENABLED=False
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100

# --- Bale bot ----------------------------------------------------------------
BALE_BOT_TOKEN=
BALE_API_BASE=https://tapi.bale.ai
BALE_POLL_TIMEOUT=30
BALE_BOT_ENABLED=True
