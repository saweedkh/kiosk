# Copy these keys into the root .env on the kiosk, then set the real POS IP.
# After editing: docker compose up -d --force-recreate backend
#
# Full checklist: docs/POS_ONSITE_CHECKLIST.md
# Protocol / why amount does not appear: docs/POS_PROTOCOL_AND_TROUBLESHOOTING.md
# Phase 2 Windows DLL bridge: docs/POS_BRIDGE.md

# --- Phase 1: raw TCP (no DLL) ------------------------------------------------
PAYMENT_GATEWAY_NAME=pos
POS_TCP_HOST=192.168.1.100
POS_TCP_PORT=1362
POS_TIMEOUT=30
POS_MESSAGE_FORMAT=pardakht_novin_official
POS_USE_SIMPLE_FORMAT=True
POS_BANNER=R2023tejaratEParsian
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_TERMINAL_ID=

# --- Phase 2: Windows PosBridge + pna.pcpos.dll (when phase 1 fails) ----------
# PAYMENT_GATEWAY_NAME=bridge
# POS_USE_BRIDGE=True
# POS_BRIDGE_HOST=host.docker.internal
# POS_BRIDGE_PORT=9000
# POS_BRIDGE_TOKEN=
# POS_BRIDGE_TIMEOUT=130
