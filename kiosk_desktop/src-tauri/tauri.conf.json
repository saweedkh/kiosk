{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kiosk",
  "version": "1.0.0",
  "identifier": "com.kiosk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:tauri --prefix ../kiosk_frontend",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build:tauri --prefix ../kiosk_frontend",
    "frontendDist": "../../kiosk_frontend/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kiosk",
        "url": "boot.html",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "decorations": true,
        "resizable": true,
        "maximized": true,
        "center": true,
        "focus": true,
        "alwaysOnTop": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: http://127.0.0.1:18765; connect-src 'self' http://127.0.0.1:18765 http://127.0.0.1:3000 ipc: http://ipc.localhost http://asset.localhost https://asset.localhost http://tauri.localhost https://tauri.localhost; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'",
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/kiosk-backend"]
  }
}
