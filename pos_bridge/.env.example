# Copy to .env next to app.py and edit.

# Listen address. Prefer LAN IP of this Windows PC, or 0.0.0.0 behind firewall.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=9000

# Path to official PNA DLL (do NOT commit licensed DLL to git on customer site if policy forbids).
# Default: look next to this folder's parent: ..\kiosk_backend\pna.pcpos.dll
POS_DLL_PATH=

# POS device on LAN
POS_IP=192.168.1.100
POS_PORT=1362

# Wait for card + PIN (seconds). Django timeout must be >= this.
POS_TIMEOUT_SECONDS=120

# Optional shared secret: Django sends header X-Pos-Bridge-Token
BRIDGE_TOKEN=
