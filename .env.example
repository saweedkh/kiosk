# =============================================================================
# Kiosk – environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# This is the single env file for the monorepo (backend + local frontend).
# =============================================================================

# --- Django -----------------------------------------------------------------
# Secret key for cryptographic signing. Generate a unique value for production.
SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode. Use True only for local development; keep False in production.
DEBUG=True

# Comma-separated hostnames allowed to serve the app.
ALLOWED_HOSTS=localhost,127.0.0.1,kiosk.local

# Backend listen port (used when running outside Docker / for reference).
SERVER_PORT=8000

# --- Frontend (local `npm run dev` only) ------------------------------------
# In production Docker, NEXT_PUBLIC_API_BASE_URL is set to `/api` by compose.
STORE_NAME=Store

# API base URL for the Next.js client during local development.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# --- Payment gateway --------------------------------------------------------
# Gateway driver: `mock` (no hardware) or `pos` (TCP card reader).
PAYMENT_GATEWAY_NAME=mock

# Merchant / terminal IDs from the payment provider (required when using `pos`).
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_TERMINAL_ID=

# --- Mock gateway (only when PAYMENT_GATEWAY_NAME=mock) ---------------------
# Artificial delay in seconds before returning a mock payment result.
MOCK_PAYMENT_DELAY=3

# If True, mock payments succeed; if False, they fail.
MOCK_PAYMENT_SUCCESS=True

# --- POS card reader (only when PAYMENT_GATEWAY_NAME=pos) -------------------
# LAN IP and TCP port of the POS terminal.
POS_TCP_HOST=192.168.1.100
POS_TCP_PORT=1362

# Seconds to wait for a POS response before timing out.
POS_TIMEOUT=30

# Use vendor DLL instead of raw TCP (usually False for direct network POS).
POS_USE_DLL=False

# Route POS traffic through a Windows bridge service (if enabled).
POS_USE_BRIDGE=False
POS_BRIDGE_HOST=192.168.1.101
POS_BRIDGE_PORT=9000

# Wire format for POS messages. Recommended: pardakht_novin_official
# Options: dll_exact | pardakht_novin_official | with_rq_and_banner |
#          with_length | with_stx_etx | with_terminator | with_null
POS_MESSAGE_FORMAT=pardakht_novin_official

# If True, use the simplified PNA-compatible payload (recommended).
POS_USE_SIMPLE_FORMAT=True

# Optional banner string (used only with with_rq_and_banner format).
POS_BANNER=R2023tejaratEParsian

# --- Network printer --------------------------------------------------------
# Enable automatic receipt printing after a successful payment.
PRINTER_ENABLED=False

# LAN IP and raw TCP port of the receipt printer (typically 9100).
PRINTER_IP=192.168.1.100
PRINTER_PORT=9100
